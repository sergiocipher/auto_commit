{
  "manifest_version": 3,
  "name": "Coding Submission Tracker",
  "description": "Uploads your first accepted LeetCode, Codeforces and CodeChef solution per period to your GitHub repo.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://codeforces.com/*",
    "https://*.codechef.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Coding Submission Tracker",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/leetcode-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content/leetcode.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://codeforces.com/*"],
      "js": ["content/codeforces.js"],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": ["https://github.com/*", "https://api.github.com/*"]
}
