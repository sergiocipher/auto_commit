# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
LOG_LEVEL=info

# Postgres / Redis (service names resolve inside docker compose)
DATABASE_URL=postgres://tracker:tracker@postgres:5432/tracker
REDIS_URL=redis://redis:6379

# GitHub OAuth App with Device Flow enabled. The client ID is public.
GITHUB_CLIENT_ID=
# Not needed for device flow; leave empty.
GITHUB_CLIENT_SECRET=
# Not used (device flow has no callback).
GITHUB_CALLBACK_URL=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# chrome-extension://<extension-id> shown on chrome://extensions
EXTENSION_ORIGIN=

UPLOAD_MAX_ATTEMPTS=6
PURGE_SOURCE_ON_SUCCESS=true
