# Copy to .env and fill in. Never commit .env.

LOG_LEVEL=info

# Host address/port the API is published on (docker compose).
API_BIND=127.0.0.1
API_PORT=8787

# Postgres credentials for the compose stack. Generate a password, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_USER=tracker
POSTGRES_PASSWORD=
POSTGRES_DB=tracker

# Only when running the backend outside docker compose (compose sets these):
# DATABASE_URL=postgres://tracker:<password>@localhost:5432/tracker
# REDIS_URL=redis://localhost:6379
# PORT=8787
# HOST=127.0.0.1   (default; compose uses 0.0.0.0 inside its private network)

# GitHub OAuth App with Device Flow enabled. The client ID is public.
GITHUB_CLIENT_ID=
# Not needed for device flow; leave empty.
GITHUB_CLIENT_SECRET=
# Not used (device flow has no callback).
GITHUB_CALLBACK_URL=

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing it makes the stored GitHub token unreadable (reconnect).
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_ID=k1
# During rotation: previous keys as id:base64, comma-separated.
APP_ENCRYPTION_OLD_KEYS=

# chrome-extension://<extension-id> as shown on chrome://extensions
EXTENSION_ORIGIN=

UPLOAD_MAX_ATTEMPTS=6
PURGE_SOURCE_ON_SUCCESS=true
RECONCILE_INTERVAL_MS=120000
